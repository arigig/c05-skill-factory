# Copy this file to .env and fill in real values. .env is git-ignored.

ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Optional: override the local-dev login defaults (submitter/submitter123,
# reviewer/reviewer123). Only relevant beyond a solo local demo.
SUBMITTER_USERNAME=submitter
SUBMITTER_PASSWORD=change-me
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=change-me
