{
  "form": {
    "id": "expense_request",
    "name": "Expense Request",
    "fields": [
      {"key": "employee_name", "label": "Employee Name", "type": "string", "required": true},
      {"key": "amount", "label": "Amount", "type": "number", "required": true},
      {"key": "expense_date", "label": "Expense Date", "type": "date", "required": true},
      {"key": "notes", "label": "Notes", "type": "string", "required": false}
    ]
  },
  "rules": [
    {"id": "amount_positive", "field": "amount", "expression": "amount > 0", "message": "Amount must be greater than zero."},
    {"id": "date_not_future", "field": "expense_date", "expression": "expense_date <= today()", "message": "Expense date cannot be in the future."}
  ],
  "workflow": {
    "name": "expense_approval",
    "approvals": [
      {"role": "manager", "action": "approve"}
    ]
  }
}
